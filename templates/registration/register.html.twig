{% extends 'base.html.twig' %}

{% form_theme registrationForm 'bootstrap_5_layout.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 mb-4 text-center">Регистрация</h1>

                    {% for flash_error in app.flashes('verify_email_error') %}
                        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
                    {% endfor %}

                    {{ form_errors(registrationForm) }}

                    {{ form_start(registrationForm) }}
                        {{ form_row(registrationForm.organizationName, {
                            label: 'Название организации',
                            attr: { autofocus: 'autofocus' }
                        }) }}
                        {{ form_row(registrationForm.email) }}
                        {{ form_row(registrationForm.plainPassword) }}
                        {{ form_row(registrationForm.agreeTerms, {
                            label: 'Согласен с условиями'
                        }) }}

                        <button type="submit" class="btn btn-primary w-100 btn-lg mt-3">Зарегистрироваться</button>
                    {{ form_end(registrationForm) }}

                    <div class="text-center mt-3">
                        <p class="mb-0">Уже есть аккаунт? <a href="{{ path('app_login') }}">Войти</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
