{% extends 'base.html.twig' %}

{% block title %}Список проектов{% endblock %}

{% block body %}
    <h1>Проекты</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Название</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
        {% for project in projects %}
            <tr>
                <td>{{ project.id }}</td>
                <td>{{ project.name }}</td>
                <td>
                    <a href="{{ path('app_project_show', {'id': project.id}) }}">просмотр</a>
                    <a href="{{ path('app_project_edit', {'id': project.id}) }}">редактировать</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Записи не найдены</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_project_new') }}" class="btn btn-primary">Создать новый проект</a>
{% endblock %}