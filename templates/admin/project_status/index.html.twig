{% extends 'base.html.twig' %}

{% block title %}Статусы проектов{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Статусы проектов</h1>

    <div class="mb-3">
        <a href="{{ path('app_admin_project_status_new') }}" class="btn btn-primary">Добавить статус</a>
        {% if project_statuses is empty %}
            <a href="{{ path('app_admin_project_status_defaults') }}" class="btn btn-outline-success ms-2">Сгенерировать по умолчанию</a>
        {% endif %}
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Название</th>
                <th>Цвет</th>
                <th>Порядок сортировки</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
        {% for status in project_statuses %}
            <tr>
                <td>{{ status.id }}</td>
                <td>{{ status.name }}</td>
                <td>
                    <span style="display:inline-block; width:16px; height:16px; border-radius:3px; background-color:{{ status.color }}; border:1px solid #ccc; vertical-align:middle; margin-right:5px;"></span>
                    {{ status.color }}
                </td>
                <td>{{ status.sortOrder }}</td>
                <td>
                    <a href="{{ path('app_admin_project_status_edit', {'id': status.id}) }}" class="btn btn-sm btn-outline-secondary">Редактировать</a>
                    <form method="post" action="{{ path('app_admin_project_status_delete', {'id': status.id}) }}" style="display: inline-block" onsubmit="return confirm('Вы уверены, что хотите удалить этот статус?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ status.id) }}">
                        <button class="btn btn-sm btn-outline-danger">Удалить</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center">Статусы не найдены.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}