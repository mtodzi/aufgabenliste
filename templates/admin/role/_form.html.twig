{{ form_start(form) }}
    <div class="mb-3">
        {{ form_label(form.name) }}
        {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
        <div class="form-text">Используйте префикс <code>ROLE_ORG_</code> для ролей организации.</div>
        {{ form_errors(form.name) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.title) }}
        {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.title) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.description) }}
        {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.description) }}
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
        <h5 class="mb-0">Права доступа (Permissions)</h5>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="select-all-permissions">
            <label class="form-check-label cursor-pointer" for="select-all-permissions">Выбрать все</label>
        </div>
    </div>
    
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        {% for permission in form.permissions %}
            <div class="col">
                <div class="form-check p-3 border rounded h-100 bg-light">
                    {{ form_widget(permission, {'attr': {'class': 'form-check-input permission-checkbox'}}) }}
                    {{ form_label(permission, null, {'label_attr': {'class': 'form-check-label fw-bold'}}) }}
                </div>
            </div>
        {% endfor %}
    </div>

    {# Помечаем поле permissions как полностью отрисованное #}
    {% do form.permissions.setRendered() %}

    <div class="mt-4 pt-3 border-top">
        <button class="btn btn-success px-4">{{ button_label|default('Сохранить изменения') }}</button>
    </div>
{{ form_end(form) }}

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const selectAllCb = document.getElementById('select-all-permissions');
        const permissionCbs = document.querySelectorAll('.permission-checkbox');

        if (selectAllCb && permissionCbs.length > 0) {
            // Обновление состояния "Выбрать все", если меняются отдельные чекбоксы
            const updateSelectAll = () => {
                const allChecked = Array.from(permissionCbs).every(cb => cb.checked);
                selectAllCb.checked = allChecked;
            };

            // Действие при клике на "Выбрать все"
            selectAllCb.addEventListener('change', (e) => {
                permissionCbs.forEach(cb => cb.checked = e.target.checked);
            });

            permissionCbs.forEach(cb => cb.addEventListener('change', updateSelectAll));

            // Инициализация при загрузке страницы
            updateSelectAll();
        }
    });
</script>