{% extends 'base.html.twig' %}

{% block title %}Роли на проекте{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Проектные роли</h1>
        <div>
            {% if not has_roles %}
                <a href="{{ path('app_admin_project_role_defaults') }}" class="btn btn-info text-white me-2">Добавить роли по умолчанию</a>
            {% endif %}
            <a href="{{ path('app_admin_project_role_new') }}" class="btn btn-primary">Создать роль</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Название</th>
                        <th>Описание</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                {% for role in project_roles %}
                    <tr>
                        <td><strong>{{ role.name }}</strong></td>
                        <td>{{ role.description|default('<span class="text-muted">Нет описания</span>')|raw }}</td>
                        <td class="text-end">
                            <a href="{{ path('app_admin_project_role_edit', {'id': role.id}) }}" class="btn btn-sm btn-outline-secondary">Изменить</a>
                            <form method="post" action="{{ path('app_admin_project_role_delete', {'id': role.id}) }}" style="display:inline-block;" onsubmit="return confirm('Удалить эту роль?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ role.id) }}">
                                <button class="btn btn-sm btn-outline-danger">Удалить</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center py-4 text-muted">У вашей организации пока нет ролей для проектов.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}