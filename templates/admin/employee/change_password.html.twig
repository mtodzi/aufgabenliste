{% extends 'base.html.twig' %}

{% block title %}Изменить пароль сотрудника{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Смена пароля</h1>
                <a href="{{ path('app_admin_employee_index') }}" class="btn btn-outline-secondary">Назад</a>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Сотрудник: {{ employee.fullName|default(employee.email) }}</h5>
                </div>
                <div class="card-body">
                    {% if not form.vars.valid %}
                        <div class="alert alert-danger shadow-sm">
                            <h6 class="alert-heading">Ошибки при заполнении:</h6>
                            <ul class="mb-0">
                                {% for error in form.vars.errors %}
                                    <li>{{ error.message }}</li>
                                {% endfor %}
                                {% for field in form.children %}
                                    {% for error in field.vars.errors %}
                                        <li><strong>{{ field.vars.label }}:</strong> {{ error.message }}</li>
                                    {% endfor %}
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    {{ form_start(form) }}
                        {{ form_row(form.generatePassword) }}

                        <div id="password-fields-wrapper">
                            {{ form_row(form.plainPassword.first) }}
                            {{ form_row(form.plainPassword.second) }}
                        </div>

                        <div class="mt-4">
                            <button class="btn btn-warning w-100" type="submit">Обновить пароль</button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const generateCheckbox = document.querySelector('input[id$="_generatePassword"]');
            const passwordWrapper = document.getElementById('password-fields-wrapper');

            const toggleFields = () => {
                passwordWrapper.style.display = generateCheckbox.checked ? 'none' : 'block';
            };

            generateCheckbox.addEventListener('change', toggleFields);
            toggleFields(); // Установка начального состояния
        });
    </script>
{% endblock %}