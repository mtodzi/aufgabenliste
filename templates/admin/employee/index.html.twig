{% extends 'base.html.twig' %}

{% block title %}Список сотрудников{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Сотрудники организации</h1>
        <a href="{{ path('app_admin_employee_new') }}" class="btn btn-primary">Добавить сотрудника</a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message|raw }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {% if employees is empty %}
        <div class="alert alert-info" role="alert">
            В вашей организации пока нет сотрудников.
        </div>
    {% else %}
        <div class="table-responsive" style="padding: 10px; margin: 10px; margin-bottom: 100px; overflow-x: visible;">
            <table class="table table-hover shadow-sm">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>ФИО</th>
                        <th>Email</th>
                        <th>Телефоны</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    {% for employee in employees %}
                        <tr>
                            <td>{{ employee.id }}</td>
                            <td>{{ employee.fullName ?? 'Не указано' }}</td> {# Вывод ФИО #}
                            <td>{{ employee.email }}</td>
                            <td>
                                {% if employee.phones is not empty %}
                                    <ul class="list-unstyled mb-0">
                                        {% for phone in employee.phones %}
                                            <li>{{ phone.number }}</li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    Нет телефонов
                                {% endif %}
                            </td> {# Вывод телефонов #}
                            <td>
                                {% if employee.isActive %}
                                    <span class="badge bg-success">Активен</span>
                                {% else %}
                                    <span class="badge bg-danger">Деактивирован</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Действия
                                    </button>
                                    <ul class="dropdown-menu shadow border-0">
                                        <li><a class="dropdown-item" href="{{ path('app_admin_employee_edit', {'id': employee.id}) }}">Редактировать профиль</a></li>
                                        <li><a class="dropdown-item" href="{{ path('app_admin_employee_change_password', {'id': employee.id}) }}">Изменить пароль</a></li>
                                        <li><a class="dropdown-item" href="{{ path('app_admin_employee_roles', {'id': employee.id}) }}">Управление ролями</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form method="post" action="{{ path('app_admin_employee_toggle_access', {'id': employee.id}) }}">
                                                <button type="submit" class="dropdown-item {% if employee.isActive %}text-danger{% else %}text-success{% endif %}" onclick="return confirm('Вы уверены, что хотите {% if employee.isActive %}деактивировать{% else %}активировать{% endif %} этого сотрудника?');">
                                                    {% if employee.isActive %}Деактивировать{% else %}Активировать{% endif %}
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}